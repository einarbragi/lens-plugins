# ---- CharacterLens tag UI builder (shared by the plugin and the test script) ----
# Needs LENSES, ADV, ADV_GROUPS, ADV_DEFAULT from the tag tables.
import json as _cl_json

CL_SAVED_BASE = 1000


def _cl_norm(s):
    return "".join(ch for ch in s.lower() if ch.isalnum())


def _cl_pin_values(otag):
    """Current values of the shader's main pins, keyed by variable name."""
    names = {"lensmodel": "LensModel", "fstop": "FStop", "focusdistance": "FocusDistance",
             "character": "Character", "bokeh": "Bokeh", "swirlamount": "SwirlAmount",
             "softness": "Softness", "fringing": "Fringing", "distortion": "Distortion",
             "vignette": "Vignette", "pixellines": "PixelLines", "wobble": "Wobble",
             "eyedistance": "EyeDistance"}
    out, inside = {}, False
    for bc, pid, _g in otag.GetDescription(c4d.DESCFLAGS_DESC_NONE):
        n = _cl_norm(bc[c4d.DESC_NAME] or "")
        if n == "lensmodel":
            inside = True
        if inside and n in names and names[n] not in out:
            try:
                out[names[n]] = otag.GetParameter(pid, c4d.DESCFLAGS_GET_NONE)
            except Exception:
                pass
        if inside and n == "frame":
            break
    return out


def _cl_add(tag, name, dtype, parent=None, default=None, mn=None, mx=None, smin=None, smax=None,
            step=None, gui=None, cycle=None, hide=False, columns=None, open_=True):
    bc = c4d.GetCustomDataTypeDefault(dtype)
    bc[c4d.DESC_NAME] = name
    bc[c4d.DESC_SHORT_NAME] = name
    if parent == "root":
        bc[c4d.DESC_PARENTGROUP] = c4d.DescID(0)      # its own tab in the Attribute Manager
    elif parent is not None:
        bc[c4d.DESC_PARENTGROUP] = parent
    if columns is not None:
        bc[c4d.DESC_COLUMNS] = columns
    if mn is not None:
        bc[c4d.DESC_MIN] = mn
    if mx is not None:
        bc[c4d.DESC_MAX] = mx
    if smin is not None:
        bc[c4d.DESC_MINSLIDER] = smin
    if smax is not None:
        bc[c4d.DESC_MAXSLIDER] = smax
    if step is not None:
        bc[c4d.DESC_STEP] = step
    if gui is not None:
        bc[c4d.DESC_CUSTOMGUI] = gui
    if cycle is not None:
        cyc = c4d.BaseContainer()
        for k, v in cycle:
            cyc.SetString(k, v)
        bc.SetContainer(c4d.DESC_CYCLE, cyc)
    if hide:
        bc[c4d.DESC_HIDE] = True
    if dtype == c4d.DTYPE_GROUP:
        bc[c4d.DESC_DEFAULT] = bool(open_)     # unfolded or folded
    did = tag.AddUserData(bc)
    if default is not None:
        try:
            tag[did] = default
        except Exception:
            pass
    return did


def _cl_old_values(ptag):
    """Every value on the tag's existing User Data, by name (groups/buttons skipped)."""
    out = {}
    for did, bc in ptag.GetUserDataContainer():
        try:
            dt = did[did.GetDepth() - 1].dtype
        except Exception:
            dt = None
        if dt in (c4d.DTYPE_GROUP, c4d.DTYPE_BUTTON, getattr(c4d, "DTYPE_SEPARATOR", -999)):
            continue
        try:
            out[bc[c4d.DESC_NAME]] = ptag[did]
        except Exception:
            pass
    return out


def build_tag_ui(ptag, otag, lenses, old=None):
    """(Re)build the CharacterLens tag's controls. Keeps every existing value
    (Focus Object, saved lenses, Advanced edits) and takes the rest from the
    shader's current pins. `old` carries values over from a replaced tag."""
    if old is None:
        old = _cl_old_values(ptag)
    for did, _bc in list(ptag.GetUserDataContainer()):
        ptag.RemoveUserData(did)
    # wipe the stored values too: Cinema 4D keeps them by slot number, so a
    # reordered control would otherwise inherit an old value of the wrong type
    try:
        ptag.GetDataInstance().RemoveData(c4d.ID_USERDATA)
    except Exception:
        pass

    try:
        saved = {int(k): s for k, s in _cl_json.loads(old.get("_saved presets") or "{}").items()}
    except Exception:
        saved = {}

    v = _cl_pin_values(otag) if otag is not None else {}
    lens = int(old.get("Lens", v.get("LensModel", 6)) or 6)
    if (lens >= CL_SAVED_BASE and lens not in saved) or (lens < CL_SAVED_BASE and lens not in lenses):
        lens = int(v.get("LensModel", 6) or 6)
    if lens < CL_SAVED_BASE and lens not in lenses:
        lens = 6                                       # a removed preset -> Cooke Panchro
    base = saved[lens]["base"] if lens in saved else lens
    g = lambda k, d: v.get(k) if v.get(k) is not None else d
    R, L, B = c4d.DTYPE_REAL, c4d.DTYPE_LONG, c4d.DTYPE_BOOL
    SL, LSL = c4d.CUSTOMGUI_REALSLIDER, c4d.CUSTOMGUI_LONGSLIDER
    BTN = c4d.CUSTOMGUI_BUTTON

    items = [(k, lenses[k][0]) for k in LENS_ORDER if k in lenses]
    items += [(k, "[Saved] " + s["name"]) for k, s in sorted(saved.items())]

    top = _cl_add(ptag, "Character Lens", c4d.DTYPE_GROUP, "root", columns=1)
    gc = _cl_add(ptag, "Colour correction", c4d.DTYPE_GROUP, top, columns=1)
    _cl_add(ptag, "Use colour correction", B, gc, False)
    _cl_add(ptag, "Exposure (stops)", R, gc, 0.0, mn=-10.0, mx=10.0, smin=-3.0, smax=3.0, step=0.05, gui=SL)
    _cl_add(ptag, "Saturation", R, gc, 1.0, mn=0.0, mx=4.0, smin=0.0, smax=2.0, step=0.01, gui=SL)
    _cl_add(ptag, "Gamma", R, gc, 1.0, mn=0.1, mx=5.0, smin=0.5, smax=2.5, step=0.01, gui=SL)
    _cl_add(ptag, "About colour correction", c4d.DTYPE_STRING, gc,
            "Uses this camera's Octane imager (Imager tab), which then replaces the global one",
            gui=getattr(c4d, "CUSTOMGUI_STATICTEXT", None))

    gl = _cl_add(ptag, "Lens & focus", c4d.DTYPE_GROUP, top, columns=1)
    _cl_add(ptag, "Lens", L, gl, lens, gui=c4d.CUSTOMGUI_CYCLE, cycle=items)
    _cl_add(ptag, "F-stop", R, gl, float(g("FStop", 1.4)), mn=0.02, mx=256.0, smin=0.1, smax=22.0, step=0.01, gui=SL)
    _cl_add(ptag, "Full character at", c4d.DTYPE_STRING, gl, "", gui=getattr(c4d, "CUSTOMGUI_STATICTEXT", None))
    _cl_add(ptag, "Focus Object", c4d.DTYPE_BASELISTLINK, gl, None)
    _cl_add(ptag, "Focus distance (cm)", R, gl, float(g("FocusDistance", 200.0)), mn=1.0, mx=1000000.0, step=1.0)

    gk = _cl_add(ptag, "Look", c4d.DTYPE_GROUP, top, columns=1)
    for name, var, mx, smax in (("Character", "Character", 3.0, 2.0),
                                ("Bokeh", "Bokeh", 3.0, 2.0), ("Swirl", "SwirlAmount", 5.0, 3.0),
                                ("Softness / glow", "Softness", 5.0, 3.0), ("Fringing", "Fringing", 10.0, 3.0),
                                ("Distortion", "Distortion", 10.0, 5.0), ("Vignette", "Vignette", 5.0, 3.0)):
        _cl_add(ptag, name, R, gk, float(g(var, 1.0)), mn=0.0, mx=mx, smin=0.0, smax=smax, step=0.01, gui=SL)
    _cl_add(ptag, "Reset look", c4d.DTYPE_BUTTON, gk, gui=BTN)

    is_style = base >= 100
    has_film = base in (115, 111, 114, 109, 108, 106, 8)     # styles with a live film look (see STYLE_LOOK)
    gs = _cl_add(ptag, "Style", c4d.DTYPE_GROUP, top, columns=1, hide=not (is_style or has_film))
    _cl_add(ptag, "Film look (grade, bloom, grain)", R, gs, 1.0, mn=0.0, mx=2.0, smin=0.0, smax=2.0,
            step=0.01, gui=SL, hide=not has_film)
    _cl_add(ptag, "Pixel lines (0 = style default)", L, gs, int(g("PixelLines", 0)), mn=0, mx=2160,
            smin=0, smax=720, hide=not is_style, gui=LSL)
    _cl_add(ptag, "Wobble / gate weave", R, gs, float(g("Wobble", 1.0)), mn=0.0, mx=3.0, smin=0.0, smax=2.0,
            step=0.01, gui=SL, hide=not is_style)
    _cl_add(ptag, "Anaglyph eye distance (cm)", R, gs, float(g("EyeDistance", 6.5)), mn=0.0, mx=50.0, smin=0.0,
            smax=15.0, step=0.1, gui=SL, hide=not is_style)

    ga = _cl_add(ptag, "Advanced", c4d.DTYPE_GROUP, top, columns=1, open_=False)
    _cl_add(ptag, "Use preset values", c4d.DTYPE_BUTTON, ga, gui=BTN)
    _cl_add(ptag, "Save as preset...", c4d.DTYPE_BUTTON, ga, gui=BTN)
    _cl_add(ptag, "Delete saved preset", c4d.DTYPE_BUTTON, ga, gui=BTN)
    sub = {}
    for gname in ADV_GROUPS:
        sub[gname] = _cl_add(ptag, gname, c4d.DTYPE_GROUP, ga, columns=1, open_=False)
    for key, _pin, label, kind, mn, mx, smin, smax, step, gname, cyc in ADV:
        d = ADV_DEFAULT[key]
        parent = sub[gname]
        if kind == "bool":
            _cl_add(ptag, label, B, parent, bool(d))
        elif kind == "cycle":
            _cl_add(ptag, label, L, parent, int(d), gui=c4d.CUSTOMGUI_CYCLE, cycle=cyc)
        elif kind == "int":
            _cl_add(ptag, label, L, parent, int(d), mn=int(mn), mx=int(mx), smin=int(smin), smax=int(smax),
                    step=int(step), gui=LSL)
        else:
            _cl_add(ptag, label, R, parent, float(d), mn=mn, mx=mx, smin=smin, smax=smax, step=step, gui=SL)

    gt = _cl_add(ptag, "Tools", c4d.DTYPE_GROUP, top, columns=1)
    _cl_add(ptag, "Compile shader", c4d.DTYPE_BUTTON, gt, gui=BTN)
    _cl_add(ptag, "Add PS1 snap to selected", c4d.DTYPE_BUTTON, gt, gui=BTN)
    _cl_add(ptag, "Copy shader code", c4d.DTYPE_BUTTON, gt, gui=BTN)
    _cl_add(ptag, "Save shader to a folder...", c4d.DTYPE_BUTTON, gt, gui=BTN)

    _cl_add(ptag, "_advanced from", L, top, -1, hide=True)        # -1 = fill Advanced from the preset
    _cl_add(ptag, "_saved presets", c4d.DTYPE_STRING, top, _cl_json.dumps({str(k): s for k, s in saved.items()}),
            hide=True)
    _cl_add(ptag, "_imager on", B, top, False, hide=True)
    _cl_add(ptag, "_imager backup", c4d.DTYPE_STRING, top, "", hide=True)

    # put back everything the tag already had (v0.6+ values, Advanced edits)
    keep = dict(old)
    keep.pop("_last lens", None)
    keep.pop("Full character at", None)
    keep.pop("About colour correction", None)
    dof = old.get("Depth of field (1 = real)")
    keep.pop("Depth of field (1 = real)", None)
    if dof is not None and abs(float(dof) - 1.0) > 1e-4 and float(dof) > 0 and "F-stop" in old:
        # v0.8 had a separate Depth of field multiplier: fold it into the F-stop
        mf = float(old.get("Widest aperture (f-number)") or 1.4)
        keep["F-stop"] = max(max(float(old["F-stop"]), mf) / float(dof), 0.02)
    if "Swirl strength" not in old and "Swirl" in old:
        # v0.7 had two controls called "Swirl"; the stored one is the Advanced value
        keep["Swirl strength"] = old["Swirl"]
        keep["Swirl"] = 1.0
    keep.pop("_saved presets", None)
    keep["Lens"] = lens
    # v0.9 halved the presets' natural vignetting: update it unless it was edited
    try:
        nv_new = float(PRESET_DIFF.get(lens, {}).get("natVig", ADV_DEFAULT["natVig"]))
        nv_old = keep.get("Natural vignetting")
        if nv_old is not None and abs(float(nv_old) - 2.0 * nv_new) < 1e-3:
            keep["Natural vignetting"] = nv_new
    except Exception:
        pass
    for did, bc in ptag.GetUserDataContainer():
        name = bc[c4d.DESC_NAME]
        if name in keep and keep[name] is not None:
            try:
                ptag[did] = keep[name]
            except Exception:
                pass


# ------------------------------------------------------ 1. camera setup
def _run_before_octane(doc, cam, ptag):
    """The CharacterLens tag has to run before the Octane Camera tag, otherwise
    Octane reads the focus distance from the previous update (focus lags one
    move behind). Put it first on the camera and early in the expression pass
    (still after animation, so animated cameras and focus objects are right)."""
    if cam.GetFirstTag() is not ptag:
        doc.AddUndo(c4d.UNDOTYPE_CHANGE, cam)
        ptag.Remove()
        cam.InsertTag(ptag)
    if ptag.GetType() != c4d.Tpython:
        return                                   # the CharacterLens tag sets its own priority
    try:
        pd = ptag[c4d.EXPRESSION_PRIORITY]
        pd.SetPriorityValue(c4d.PRIORITYVALUE_MODE, c4d.CYCLE_EXPRESSION)
        pd.SetPriorityValue(c4d.PRIORITYVALUE_PRIORITY, -100)
        ptag[c4d.EXPRESSION_PRIORITY] = pd
    except Exception:
        pass


def _status(text):
    print("CharacterLens: " + text.replace("\n", " "))
    try:
        c4d.StatusSetText("CharacterLens: " + text.split("\n")[0])
    except Exception:
        pass


def _camera_from_view(doc):
    """A new camera where the viewport is looking from."""
    cam = c4d.BaseObject(c4d.Ocamera)
    cam.SetName("Octane Camera")
    bd = doc.GetActiveBaseDraw()
    view = bd.GetSceneCamera(doc) if bd is not None else None
    if view is not None:
        cam.SetMg(view.GetMg())
        try:
            cam[c4d.CAMERA_FOCUS] = view[c4d.CAMERA_FOCUS]
        except Exception:
            pass
    doc.InsertObject(cam)
    doc.AddUndo(c4d.UNDOTYPE_NEW, cam)
    return cam


def _selected_camera(doc):
    cam = doc.GetActiveObject()
    if cam is not None and cam.CheckType(c4d.Ocamera):
        return cam
    tag = doc.GetActiveTag()
    obj = tag.GetObject() if tag is not None else None
    if obj is not None and obj.CheckType(c4d.Ocamera):
        return obj
    return None


def setup_camera(doc, cam=None):
    """One click: set up the selected camera, or make a new one from the view."""
    doc.StartUndo()
    report = []
    if cam is None:
        cam = _selected_camera(doc)
    if cam is None:
        cam = _camera_from_view(doc)
        report.append("New camera '%s' made from the view" % cam.GetName())
    otag = _octane_camera_tag(cam)
    if otag is None:
        doc.EndUndo()
        _status("no Octane Camera tag could be added to '%s' - is Octane installed?" % cam.GetName())
        return
    doc.AddUndo(c4d.UNDOTYPE_CHANGE, otag)

    # camera type -> OSL
    bc, pid = _find(otag, "Camera type")
    if pid is not None:
        cyc = bc.GetContainer(c4d.DESC_CYCLE)
        osl_val = None
        for k, v in cyc:
            if isinstance(v, str) and v.strip().lower() == "osl":
                osl_val = k
        if osl_val is not None:
            otag[pid] = osl_val
            report.append("Camera type set to OSL")
    otag.Message(c4d.MSG_UPDATE)
    c4d.EventAdd()

    # OSL code -> compile
    ok = False
    _b, code_pid = _find(otag, "Code")
    if code_pid is not None:
        try:
            otag.SetParameter(code_pid, OSL_SOURCE, c4d.DESCFLAGS_SET_NONE)
            got = otag.GetParameter(code_pid, c4d.DESCFLAGS_GET_NONE)
            ok = isinstance(got, str) and got.strip()[:40] == OSL_SOURCE.strip()[:40]
        except Exception:
            ok = False
    if ok:
        bd = doc.GetActiveBaseDraw()
        if bd is not None:
            bd.SetSceneCamera(cam)
            report.append("Viewport set to look through '%s'" % cam.GetName())
        _b, comp_pid = _find(otag, "Compile")
        if comp_pid is not None:
            try:
                c4d.CallButton(otag, comp_pid[comp_pid.GetDepth() - 1].id)
                report.append("Shader code set and Compile pressed")
            except Exception:
                report.append("Shader code set")
        else:
            report.append("Shader code set")
        report.append("Octane compiles it once the Live Viewer renders through this camera")
    else:
        c4d.CopyStringToClipboard(OSL_SOURCE)
        report.append("Could not fill the OSL Code field automatically - the shader is on your clipboard: "
                      "paste it into the OSL Camera's Code field and press Compile")

    # CharacterLens tag with all the controls: the plugin's own tag type, or a
    # Python tag if that type couldn't be registered
    ptag, old_py = None, None
    for t in cam.GetTags():
        if t.GetType() == TAG_ID:
            ptag = t
        elif t.GetType() == c4d.Tpython and t.GetName() == "CharacterLens":
            old_py = t
    old_values = None
    if ptag is None and _TAG_OK:
        ptag = c4d.BaseTag(TAG_ID)
        ptag.SetName("CharacterLens")
        cam.InsertTag(ptag)
        doc.AddUndo(c4d.UNDOTYPE_NEW, ptag)
        if old_py is not None:
            old_values = _cl_old_values(old_py)
            doc.AddUndo(c4d.UNDOTYPE_DELETEOBJ, old_py)
            old_py.Remove()
            report.append("Old Python CharacterLens tag replaced by the CharacterLens tag (settings kept)")
        else:
            report.append("CharacterLens tag added - all controls are on it")
    elif ptag is None:
        ptag = old_py
        if ptag is None:
            ptag = c4d.BaseTag(c4d.Tpython)
            ptag.SetName("CharacterLens")
            cam.InsertTag(ptag)
            doc.AddUndo(c4d.UNDOTYPE_NEW, ptag)
            report.append("CharacterLens tag added - all controls are on it")
        else:
            doc.AddUndo(c4d.UNDOTYPE_CHANGE, ptag)
            report.append("CharacterLens tag updated - all controls are on it")
        ptag[c4d.TPYTHON_CODE] = TAG_CODE
        icon_pid = getattr(c4d, "ID_BASELIST_ICON_FILE", None)
        if icon_pid is not None:
            try:
                ptag[icon_pid] = str(PLUGIN_ID)     # the CharacterLens icon (registered above)
            except Exception:
                pass
    else:
        doc.AddUndo(c4d.UNDOTYPE_CHANGE, ptag)
        report.append("CharacterLens tag updated - all controls are on it")
    build_tag_ui(ptag, otag, LENSES, old_values)
    _run_before_octane(doc, cam, ptag)
    doc.SetActiveTag(ptag)
    doc.EndUndo()
    c4d.EventAdd()

    c4d.EventAdd()
    _status("set up on '%s'. %s." % (cam.GetName(), "; ".join(report)))


# ------------------------------------------------------ 2. PS1 snap
def add_ps1_snap(doc):
    flags = getattr(c4d, "GETACTIVEOBJECTFLAGS_NONE", 0)
    sel = doc.GetActiveObjects(flags)
    sel = [o for o in sel if not o.CheckType(c4d.Ocamera)]
    if not sel:
        gui.MessageDialog("Select the objects that should get the PS1 vertex wobble, then press this again.")
        return
    doc.StartUndo()
    gen = c4d.BaseObject(c4d.Opython)
    gen.SetName("PS1 Vertex Snap")
    gen[c4d.OPYTHON_CODE] = PS1_CODE
    opt = getattr(c4d, "OPYTHON_OPTIMIZE", None)
    if opt is not None:
        gen[opt] = False
    _add_ud(gen, "Grid lines", c4d.DTYPE_LONG, 240)
    _add_ud(gen, "Depth steps (cm)", c4d.DTYPE_REAL, 0.0)
    _add_ud(gen, "Strength", c4d.DTYPE_REAL, 1.0)
    first = sel[0]
    doc.InsertObject(gen, first.GetUp(), first.GetPred())
    doc.AddUndo(c4d.UNDOTYPE_NEW, gen)
    for o in sel:
        mg = o.GetMg()
        doc.AddUndo(c4d.UNDOTYPE_CHANGE, o)
        o.Remove()
        o.InsertUnderLast(gen)
        o.SetMg(mg)
    doc.EndUndo()
    doc.SetActiveObject(gen)
    c4d.EventAdd()


# ------------------------------------------------------ 3. shader files
def export_files(folder):
    if not folder:
        return
    os.makedirs(folder, exist_ok=True)
    for name, text in (("CharacterLens.osl", OSL_SOURCE), ("CharacterLens_Tag.py", TAG_LOGIC),
                       ("CharacterLens_PS1_Snap_generator.py", PS1_CODE)):
        with open(os.path.join(folder, name), "w", encoding="utf-8") as f:
            f.write(text)
    _status("saved CharacterLens.osl and the tag/generator code to " + folder)


def _hook_copy(doc):
    c4d.CopyStringToClipboard(OSL_SOURCE)
    _status("shader code copied - paste it into the OSL Camera's Code field and press Compile")


def _hook_export(doc):
    p = c4d.storage.LoadDialog(c4d.FILESELECTTYPE_ANYTHING, "Save CharacterLens shader to", c4d.FILESELECT_DIRECTORY)
    if p:
        export_files(p)


# ------------------------------------------------------ 4. film looks (colour grades)
def _luma(r, g, b):
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _clamp(x):
    return 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)


def _grade(r, g, b, sat=1.0, contrast=0.0, lift=(0, 0, 0), gain=(1, 1, 1), gamma=(1, 1, 1)):
    y = _luma(r, g, b)
    out = []
    for i, c in enumerate((r, g, b)):
        c = _clamp(y + (c - y) * sat)
        c = c + (c * c * (3.0 - 2.0 * c) - c) * contrast          # S-curve
        c = _clamp(c) ** gamma[i]
        out.append(_clamp(lift[i] + (gain[i] - lift[i]) * c))
    return out


def _nightvision(r, g, b):
    y = _clamp(_luma(r, g, b))                                      # one phosphor: monochrome green
    y = y + (y * y * (3.0 - 2.0 * y) - y) * 0.6                      # contrast: murky mids, bright highlights
    return (0.015 + 0.3 * y ** 1.6, 0.02 + 0.92 * y ** 1.3, 0.005 + 0.12 * y ** 1.8)


FILM_LUTS = {
    "nightvision": _nightvision,
    "cctv": lambda r, g, b: _grade(r, g, b, 0.25, 0.5, (0.0, 0.01, 0.01), (0.92, 1.0, 0.97), (1.1, 1.0, 1.02)),
    "webcam": lambda r, g, b: _grade(r, g, b, 0.85, 0.45, (0.0, 0.0, 0.02), (0.95, 1.0, 1.08), (1.05, 1.0, 0.95)),
    "super8": lambda r, g, b: _grade(r, g, b, 1.1, 0.25, (0.07, 0.05, 0.03), (1.0, 0.95, 0.8), (0.92, 1.0, 1.12)),
    "toy": lambda r, g, b: _grade(r, g, b, 1.35, 0.6, (0.0, 0.04, 0.07), (1.0, 0.98, 0.78), (1.15, 1.0, 0.85)),
    "vhs": lambda r, g, b: _grade(r, g, b, 0.8, 0.2, (0.06, 0.04, 0.07), (0.95, 0.94, 0.97), (1.0, 1.03, 0.98)),
    "disposable": lambda r, g, b: _grade(r, g, b, 1.15, 0.35, (0.02, 0.04, 0.02), (1.0, 0.97, 0.86), (0.95, 1.0, 1.08)),
}


def _cube(fn, n=17):
    lines = ["TITLE \"CharacterLens\"", "LUT_3D_SIZE %d" % n]
    for bi in range(n):
        for gi in range(n):
            for ri in range(n):
                c = fn(ri / (n - 1.0), gi / (n - 1.0), bi / (n - 1.0))
                lines.append("%.5f %.5f %.5f" % tuple(c))
    return "\n".join(lines) + "\n"


def _write_luts():
    """Write the looks' .cube files next to the plugin (or to temp); returns the folder."""
    for base in (os.path.join(os.path.dirname(os.path.abspath(__file__)), "characterlens_res"),
                 os.path.join(tempfile.gettempdir(), "characterlens_res")):
        folder = os.path.join(base, "luts")
        try:
            os.makedirs(folder, exist_ok=True)
            for name, fn in FILM_LUTS.items():
                path = os.path.join(folder, name + ".cube")
                text = _cube(fn)
                if not os.path.exists(path) or open(path).read() != text:
                    with open(path, "w") as f:
                        f.write(text)
            return folder
        except Exception:
            continue
    return ""


# ------------------------------------------------------ 5. the one-click command
class CharacterLensCommand(c4d.plugins.CommandData):
    def Execute(self, doc):
        setup_camera(doc)
        return True


