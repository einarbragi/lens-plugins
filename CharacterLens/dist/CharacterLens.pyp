    120: {'roundness': 0.9, 'catEye': 0.2, 'rimRadius': 1.2, 'maxF': 1.9, 'sa': 0.02, 'coma': 0.02, 'astig': 0.01, 'fc': 0.01, 'k1': 0.005, 'latCA': 0.2, 'longCA': 0.3, 'secCA': 0.15, 'sphCA': 0.2, 'natVig': 0.2, 'glass': 1, 'glassAmt': 1.0},
