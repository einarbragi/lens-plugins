    123: {'roundness': 0.9, 'catEye': 0.2, 'rimRadius': 1.2, 'maxF': 1.9, 'sa': 0.02, 'coma': 0.02, 'astig': 0.01, 'fc': 0.01, 'k1': 0.005, 'latCA': 0.2, 'longCA': 0.3, 'secCA': 0.15, 'sphCA': 0.2, 'natVig': 0.2, 'port': 1, 's:haze': 0.15, 's:hazeSpread': 0.25, 'tint:0': 0.55, 'tint:1': 0.9, 'tint:2': 1.05},
    124: {'roundness': 0.9, 'catEye': 0.2, 'rimRadius': 1.2, 'maxF': 1.9, 'sa': 0.02, 'coma': 0.02, 'astig': 0.01, 'fc': 0.01, 'k1': 0.005, 'latCA': 0.2, 'longCA': 0.3, 'secCA': 0.15, 'sphCA': 0.2, 'natVig': 0.2, 'tilt': 10.0, 'apBoost': 4.0},
    125: {'roundness': 0.9, 'catEye': 0.2, 'rimRadius': 1.2, 'maxF': 1.9, 'sa': 0.02, 'coma': 0.02, 'astig': 0.01, 'fc': 0.01, 'k1': 0.005, 'latCA': 0.2, 'longCA': 0.3, 'secCA': 0.15, 'sphCA': 0.2, 'natVig': 0.2, 'proj': 5, 'zoom': 0.5, 'lensAmt': 0.0, 'noDOF': 1},
