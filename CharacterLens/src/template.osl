// ============================================================================
//  CharacterLens.osl  -  v0.8
//  Lens character + stylized cameras for OctaneRender (OSL Camera node).
//
//  Pick a Lens (real lenses first, then "Style:" cameras), set F-stop, focus
//  with the CharacterLens tag's Focus Object, then dial the look.
//  Character scales everything (lens character and style effects).
//
//  Real lenses: thin lens + Seidel aberrations (pupil normalised to wide
//  open), spectral chromatic aberration, cat-eye / optical vignetting,
//  focus breathing, veiling haze, diffraction, anamorphic squeeze.
//  Styles: pixel grids, CRT, VHS, fisheyes, 360, tiny planet, mirror ball,
//  orthographic, Doom shear, anaglyph, prism, kaleidoscope, compound eye,
//  textured glass, underwater port, tilt-shift.
//  Parts that a camera can't do (colour depth, palettes, noise, overlays,
//  rolling shutter) are in characterlens_post.py; PS1 vertex snapping is the
//  CharacterLens_Setup.py "PS1 vertex snap" generator.
//
//  Custom = 1 (set by the CharacterLens tag) takes every per-lens and
//  per-style value from the A_ inputs instead of the built-in tables, so the
//  tag's Advanced group can edit them. The Look sliders still scale them.
//
//  Generated by build7.py from looks.py - edit looks.py and rebuild.
//  Focus distance is in C4D centimetres. If it won't compile, set
//  USE_SPECTRAL to 0.
// ============================================================================

#define USE_SPECTRAL 1

#if USE_SPECTRAL
#include <octane-oslintrin.h>
#endif

// Aperture outline radius at angle phi (1 = circle). Polygon blended to a
// circle by roundness.
float apertureRadiusAt(float phi, int blades, float roundness, float rot)
{
    if (blades < 3)
        return 1.0;
    float seg = 2.0 * M_PI / (float)blades;
    float a   = mod(phi - rot, seg) - 0.5 * seg;
    float s   = cos(0.5 * seg) / cos(a);
    return mix(s, 1.0, clamp(roundness, 0.0, 1.0));
}

// A Look slider applied to one lens value: below 1 it scales the value down,
// above 1 it adds at least `ref` per step, keeping the value's sign.
float lookScale(float x0, float L, float ref)
{
    float amt = (fabs(x0) > ref) ? x0 : ((x0 < 0.0) ? -ref : ref);
    return x0 * min(L, 1.0) + max(L - 1.0, 0.0) * amt;
}

// Extra decorrelated random numbers derived from Octane's two lens randoms.
float rnd(float a, float b, float k)
{
    return cellnoise(point(floor(a * 65536.0), floor(b * 65536.0), k * 17.0));
}

float gauss(float a, float b)
{
    return sqrt(-2.0 * log(max(a, 1e-7))) * cos(2.0 * M_PI * b);
}

//@@LENSDATA@@

//@@STYLEDATA@@

//@@LENSSTYLE@@

// ============================================================================
shader CharacterLens(
    // ---------------- Lens ----------------
    int   LensModel = 6 [[ string page = "Lens", string label = "Lens", string widget = "mapper",
            string options = "@@OPTIONS@@" ]],
    float FStop = 1.4 [[ string page = "Lens", string label = "F-stop",
            float min = 0.02, float max = 256, float slidermin = 0.1, float slidermax = 22, float sliderexponent = 2,
            string help = "Below the lens's widest aperture the blur keeps growing; the lens character stays at its wide-open look." ]],
    float FocusDistance = 200 [[ string page = "Lens", string label = "Focus distance (cm)",
            float min = 1, float max = 1000000, float slidermin = 10, float slidermax = 2000, float sliderexponent = 3,
            string help = "Set automatically from the CharacterLens tag's Focus Object." ]],

    // ---------------- Look (1 = as designed) ----------------
    float Character = 1.0 [[ string page = "Look", string label = "Character", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2,
            string help = "Everything at once: lens character and style effects. 0 = perfect lens." ]],
    float Bokeh = 1.0 [[ string page = "Look", string label = "Bokeh", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],
    float SwirlAmount = 1.0 [[ string page = "Look", string label = "Swirl", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],
    float Softness = 1.0 [[ string page = "Look", string label = "Softness / glow", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],
    float Fringing = 1.0 [[ string page = "Look", string label = "Fringing", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],
    float Distortion = 1.0 [[ string page = "Look", string label = "Distortion", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],
    float Vignette = 1.0 [[ string page = "Look", string label = "Vignette", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],

    // ---------------- Style ----------------
    int   PixelLines = 0 [[ string page = "Style", string label = "Pixel lines (0 = style default)",
            int min = 0, int max = 2160, int slidermin = 0, int slidermax = 720,
            string help = "Vertical resolution of the pixel grid. Works on any lens." ]],
    float Wobble = 1.0 [[ string page = "Style", string label = "Wobble / gate weave", float min = 0, float max = 3, float slidermin = 0, float slidermax = 2 ]],
    float EyeDistance = 6.5 [[ string page = "Style", string label = "Anaglyph eye distance (cm)", float min = 0, float max = 50, float slidermin = 0, float slidermax = 15 ]],

    // ---------------- Auto (driven by the C4D camera via the tag) ----------------
    float FocalLength = 85 [[ string page = "Auto (from camera)", string label = "Focal length (mm)", float min = 1, float max = 1200 ]],
    float SensorWidth = 36 [[ string page = "Auto (from camera)", string label = "Sensor width (mm)", float min = 1, float max = 80 ]],
    float Frame = 0 [[ string page = "Auto (from camera)", string label = "Frame", float min = -100000, float max = 100000 ]],

    // ---------------- Advanced (driven by the tag; Custom = 1 uses them) ----------------
    int   Custom = 0 [[ string page = "Advanced", string label = "Use Advanced values", string widget = "checkBox" ]],
//@@ADVPINS@@

    output point  pos  = 0,
    output vector dir  = 0,
    output float  tMax = 1.0/0.0)
{
    // ------------------------------------------------------------- randoms
    float dof[2] = { 0.5, 0.5 };
    getattribute("camera:dofrandom", dof);
    float r1 = dof[0];
    float r2 = dof[1];
    float q[18];
    for (int i = 0; i < 18; i++)
        q[i] = rnd(r1, r2, (float)(i + 1));
    // q: 0 colour pick | 1,2 chroma smear | 3-6 pixel filter | 7 prism copy
    //    8-11 glass | 12-14 haze | 15,16 diffraction

    // ------------------------------------------------------ style defaults
    int   isStyle = (LensModel >= 100) ? 1 : 0;
    int   proj = 0;        float fov = 0.0;       float circle = 0.0;
    float pixLines = 0.0;  float pixAspect = 1.0; float pixSoft = 0.0;
    float scan = 0.0;      float mask = 0.0;      float curve = 0.0;
    float conv = 0.0;      float chromaSmear = 0.0;
    float wobble = 0.0;    float weave = 0.0;     float gate = 0.0;
    color tint = color(1.0);
    float tube = 0.0;      float copies = 0.0;    float prismOffset = 0.0;
    float kaleido = 0.0;   float cells = 0.0;
    int   glass = 0;       float glassAmt = 0.0;  int stereo = 0;
    float tilt = 0.0;      int port = 0;          float apBoost = 1.0;
    float lensAmt = 1.0;   int noDOF = 0;         float extraVig = 0.0;
    float extraK1 = 0.0;   float extraFC = 0.0;   float sHaze = 0.0;
    float sHazeSpread = 0.0; int baseLens = 1;
    float zoom = 0.0;      float orthoWidth = 0.0;    float revStrength = 0.0;
    if (isStyle != 0)
        styleData(LensModel, proj, fov, circle, pixLines, pixAspect, pixSoft, scan, mask,
                  curve, conv, chromaSmear, wobble, weave, gate, tint, tube, copies,
                  prismOffset, kaleido, cells, glass, glassAmt, stereo, tilt, port,
                  apBoost, lensAmt, noDOF, extraVig, extraK1, extraFC, sHaze,
                  sHazeSpread, baseLens, zoom, orthoWidth, revStrength);
    else
        lensStyle(LensModel, proj, noDOF);  // real lenses with a projection (fisheyes)

    // ------------------------------------------------------- lens character
    int   blades = 9;      float roundness = 0.8; float rimBias = 0.0;
    float onion = 0.0;     float catEye = 0.3;    float rimRadius = 1.1;
    float swirl = 0.0;     float sa = 0.05;       float coma = 0.05;
    float astig = 0.03;    float fc = 0.03;       float k1 = 0.0;
    float k2 = 0.0;        float latCA = 0.5;     float longCA = 0.8;
    float secCA = 0.4;     float sphCA = 0.5;     float natVig = 0.7;
    float castAmt = 0.0;   float warmth = 0.0;    float breathing = 0.0;
    float maxF = 1.4;      float squeeze = 1.0;   float haze = 0.0;
    float hazeSpread = 0.05;
    lensData((isStyle != 0) ? baseLens : LensModel,
             blades, roundness, rimBias, onion, catEye, rimRadius, swirl, sa, coma,
             astig, fc, k1, k2, latCA, longCA, secCA, sphCA, natVig, castAmt, warmth,
             breathing, maxF, squeeze, haze, hazeSpread);

    // Advanced values from the tag replace the tables
    if (Custom != 0) {
//@@ADVAPPLY@@
    }

    float catEye0 = catEye;               // as designed: sets the optical vignetting
    // Look sliders: 0-1 scales the lens's own value down; above 1 adds a
    // standard amount, so a lens without (say) swirl still responds
    rimBias *= Bokeh;  onion *= Bokeh;
    catEye = lookScale(catEye, Bokeh, 0.3);
    swirl  = lookScale(swirl, SwirlAmount, 0.3);
    sa   = lookScale(sa, Softness, 0.15);   coma = lookScale(coma, Softness, 0.1);
    astig = lookScale(astig, Softness, 0.05);  fc = lookScale(fc, Softness, 0.05);
    haze = lookScale(haze, Softness, 0.05);
    latCA  = lookScale(latCA, Fringing, 1.0);   longCA = lookScale(longCA, Fringing, 1.0);
    secCA  = lookScale(secCA, Fringing, 0.5);   sphCA  = lookScale(sphCA, Fringing, 0.5);
    k1 = lookScale(k1, Distortion, 0.03);  k2 *= Distortion;
    natVig *= Vignette;  extraVig *= Vignette;

    k1 += extraK1;  fc += extraFC;
    haze = max(haze, sHaze);
    if (sHazeSpread > 0.0) hazeSpread = sHazeSpread;

    float sAmt = max(Character, 0.0);     // style effect strength
    float od   = sAmt * lensAmt;          // lens character strength
    float S    = max(squeeze, 0.1);
    color castCol = (warmth >= 0.0)
        ? mix(color(1.0), color(1.0, 0.88, 0.72), warmth)
        : mix(color(1.0), color(0.78, 0.88, 1.0), -warmth);

    // ------------------------------------------------- wavelength / channel
    int   chroma = (stereo != 0) ? 2 : 1;
    int   ch     = 1;                 // RGB channel when chroma == 2
    float t      = 0.0;               // (lambda - 550nm) / 150nm
    color thr    = color(1.0);
    if (chroma == 1) {
#if USE_SPECTRAL
        float wl[4];
        if (getattribute("color:wavelengths", wl)) {
            int idx = (int)min(floor(q[0] * 4.0), 3.0);
            t   = (wl[idx] - 550.0) / 150.0;
            thr = _spectrum(idx == 0 ? 4.0 : 0.0, idx == 1 ? 4.0 : 0.0,
                            idx == 2 ? 4.0 : 0.0, idx == 3 ? 4.0 : 0.0);
        } else {
            chroma = 2;
        }
#else
        chroma = 2;
#endif
    }
    if (chroma == 2) {
        ch = (int)min(floor(q[0] * 3.0), 2.0);
        if (ch == 0)      { t =  0.40; thr = color(3.0, 0.0, 0.0); }
        else if (ch == 1) { t =  0.00; thr = color(0.0, 3.0, 0.0); }
        else              { t = -0.57; thr = color(0.0, 0.0, 3.0); }
    }
    if (stereo != 0) t = 0.0;         // no CA in anaglyph

    // ----------------------------------------------------- film coordinates
    int   res[2];
    float pa = 1.0;
    getattribute("camera:resolution", res);
    getattribute("camera:pixelaspect", pa);
    float aspect = (float)res[0] / ((float)res[1] * pa);

    // height units: hy in [-1,1], hx in [-aspect, aspect]
    float hx = (2.0 * u - 1.0) * aspect;
    float hy = (2.0 * v - 1.0);
    float hField2 = (hx * hx + hy * hy) / (aspect * aspect + 1.0);   // 1 = corner

    int   alive = 1;
    color sTint = color(1.0);
    float wob   = sAmt * Wobble;
    float lines = (PixelLines > 0) ? (float)PixelLines : pixLines;

    // gate weave (Super 8)
    if (weave > 0.0) {
        hx += weave * wob * 0.012 * noise("perlin", point(Frame * 0.43, 0.5, 0.0));
        hy += weave * wob * 0.012 * noise("perlin", point(Frame * 0.43, 7.5, 0.0));
    }
    // CRT screen curvature
    if (curve > 0.0) {
        float c  = curve * sAmt;
        float X  = hx / aspect;
        float Y  = hy;
        float X2 = X * (1.0 + c * Y * Y);
        float Y2 = Y * (1.0 + c * X * X);
        if (fabs(X2) > 1.0 || fabs(Y2) > 1.0) alive = 0;
        hx = X2 * aspect;
        hy = Y2;
    }
    // rounded film / screen gate
    if (gate > 0.0) {
        float gqx = max(fabs(hx) - (aspect - gate), 0.0);
        float gqy = max(fabs(hy) - (1.0 - gate), 0.0);
        if (gqx * gqx + gqy * gqy > gate * gate) alive = 0;
    }
    // night-vision tube
    if (tube > 0.0) {
        float tr = sqrt(hx * hx + hy * hy) / tube;
        if (tr > 1.0) alive = 0;
        sTint *= 1.0 - 0.8 * smoothstep(0.7, 1.0, tr);
    }
    // VHS line wobble
    if (wobble > 0.0) {
        float ln = floor((hy * 0.5 + 0.5) * max(lines, 240.0));
        hx += wobble * wob * (0.012 * noise("perlin", point(ln * 0.05, Frame * 0.9, 3.0))
                            + 0.004 * noise("perlin", point(ln * 0.9, Frame * 3.1, 5.0)));
    }
    // colour convergence (CRT) and chroma smear (VHS)
    if (conv > 0.0)        hx += t * conv * sAmt * 0.006;
    if (chromaSmear > 0.0) hx += fabs(t) * chromaSmear * sAmt * 0.03 * (q[1] + q[2] - 1.0);

    // scanlines + phosphor mask
    if (scan > 0.0 || mask > 0.0) {
        float L  = (lines > 0.0) ? lines : 480.0;
        float vp = (hy * 0.5 + 0.5) * L;
        float s  = clamp(scan * sAmt, 0.0, 0.95);
        sTint *= (1.0 - s * (0.5 + 0.5 * cos(2.0 * M_PI * vp))) / (1.0 - 0.5 * s);
        if (mask > 0.0) {
            float ci = mod(floor((hx / aspect * 0.5 + 0.5) * L * aspect * 3.0), 3.0);
            color tri = (ci < 0.5) ? color(3.0, 0.0, 0.0)
                      : ((ci < 1.5) ? color(0.0, 3.0, 0.0) : color(0.0, 0.0, 3.0));
            sTint *= mix(color(1.0), tri, clamp(mask * sAmt, 0.0, 1.0));
        }
    }
    // pixel grid (hard = PS1/Doom/Game Boy, soft = N64/VHS/webcam)
    if (lines > 0.0) {
        float cols = lines * aspect / max(pixAspect, 0.1);
        float gx = floor((hx / aspect * 0.5 + 0.5) * cols) + 0.5 + pixSoft * (q[3] + q[4] - 1.0);
        float gy = floor((hy * 0.5 + 0.5) * lines)         + 0.5 + pixSoft * (q[5] + q[6] - 1.0);
        hx = (gx / cols * 2.0 - 1.0) * aspect;
        hy = gy / lines * 2.0 - 1.0;
    }
    // kaleidoscope (mirror fold)
    if (kaleido > 1.0) {
        float kr  = sqrt(hx * hx + hy * hy);
        float seg = 2.0 * M_PI / kaleido;
        float ka  = mod(atan2(hy, hx), seg);
        if (ka > 0.5 * seg) ka = seg - ka;
        hx = kr * cos(ka);
        hy = kr * sin(ka);
    }
    // prism filter (ghost copies around the centre image)
    if (copies > 1.0) {
        float k = floor(q[7] * copies);
        if (k > 0.5) {
            float ang = 2.0 * M_PI * (k - 1.0) / (copies - 1.0);
            hx += prismOffset * sAmt * cos(ang);
            hy += prismOffset * sAmt * sin(ang);
        }
    }
    // compound eye (honeycomb of mini images)
    if (cells > 0.0) {
        float R  = (2.0 * aspect / cells) / 1.7320508;
        float cq = (0.57735027 * hx - 0.33333333 * hy) / R;
        float cr = (0.66666667 * hy) / R;
        float cs = -cq - cr;
        float rq = round(cq), rr_ = round(cr), rs = round(cs);
        float dq = fabs(rq - cq), dr = fabs(rr_ - cr), ds = fabs(rs - cs);
        if (dq > dr && dq > ds) rq = -rr_ - rs;
        else if (dr > ds)       rr_ = -rq - rs;
        float ccx = R * 1.7320508 * (rq + rr_ * 0.5);
        float ccy = R * 1.5 * rr_;
        float lx = (hx - ccx) / R;
        float ly = (hy - ccy) / R;
        float hd = max(fabs(lx), 0.5 * fabs(lx) + 0.8660254 * fabs(ly)) / 0.8660254;
        sTint *= 1.0 - smoothstep(0.78, 1.0, hd);
        hx = lx * 0.9 + ccx * 0.35;
        hy = ly * 0.9 + ccy * 0.35;
    }
    // textured glass in front of the lens
    if (glass > 0) {
        float g = glassAmt * sAmt;
        if (glass == 1) {           // frosted
            hx += g * 0.05 * (q[8] + q[9] - 1.0);
            hy += g * 0.05 * (q[10] + q[11] - 1.0);
        } else if (glass == 2) {    // ribbed / fluted
            float w  = 2.0 * aspect / 16.0;
            float lr = mod(hx, w) / w - 0.5;
            hx -= g * lr * w * 2.2;
            hy += g * 0.01 * (q[8] + q[9] - 1.0);
        } else {                    // pebbled shower door
            vector nn = noise("perlin", point(hx * 6.0, hy * 6.0, 0.0));
            hx += g * (0.06 * nn[0] + 0.01 * (q[8] + q[9] - 1.0));
            hy += g * (0.06 * nn[1] + 0.01 * (q[10] + q[11] - 1.0));
        }
    }

    float xn = hx / aspect;           // width units (x in [-1,1])
    float yn = hy / aspect;

    // ----------------------------------------------------------- projection
    point  Lp     = point(0.0, 0.0, 0.0);
    vector dcam   = vector(0.0, 0.0, -1.0);
    float  weight = 1.0;
    float  sensorW = SensorWidth;

    if (proj == 0) {
        // ---------------- real lens model ----------------
        float f = FocalLength * 0.001;
        if (fov > 0.0) f = (sensorW * 0.0005) / tan(radians(fov) * 0.5);
        float halfW    = sensorW * 0.0005;
        float sx       = xn * halfW;
        float sy       = yn * halfW * S;
        float halfDiag = halfW * sqrt(1.0 + (S / aspect) * (S / aspect));
        float Hx = sx / halfDiag;
        float Hy = sy / halfDiag;
        float h2 = Hx * Hx + Hy * Hy;
        float h  = sqrt(h2);

        float D    = max(FocusDistance * 0.01, f * 1.05);
        float vimg = f * D / (D - f);
        float vEff = max(f + breathing * (vimg - f), 0.2 * f);
        float Nf   = max(FStop, maxF);

        // aperture sample. Samples outside the cat-eye overlap are drawn again
        // (not killed), so Bokeh changes the bokeh shape without darkening the frame.
        float kexp  = 2.0 * pow(4.0, clamp(rimBias, -1.0, 1.0));
        float apRatio = (noDOF != 0) ? 0.0 : (maxF / Nf);
        float sw = swirl * od * h2;
        float ox = catEye * od * Hx;
        float oy = catEye * od * Hy;
        float rr = rimRadius * rimRadius;
        // the rims can't slide fully past each other: keep an opening
        float omax = 0.85 * rimRadius;
        float ol = sqrt(ox * ox + oy * oy);
        if (ol > 1e-6) { float k = omax * tanh(ol / omax) / ol; ox *= k; oy *= k; }   // soft limit
        float px = 0.0, py = 0.0;
        int   hit = 0;
        for (int tryN = 0; tryN < 8 && hit == 0; tryN++) {
            float u1 = (tryN == 0) ? r1 : rnd(r1, r2, 11.0 + tryN);
            float u2 = (tryN == 0) ? r2 : rnd(r2, r1, 23.0 + tryN);
            float rho   = pow(max(u1, 1e-7), 1.0 / kexp);
            float phi   = 2.0 * M_PI * u2;
            float shape = apertureRadiusAt(phi, blades, roundness, 0.0);
            weight = shape * shape;
            if (onion > 0.0)
                weight *= max(0.0, 1.0 + onion * cos(2.0 * M_PI * 6.0 * rho));
            px = rho * shape * cos(phi) * apRatio / S;
            py = rho * shape * sin(phi) * apRatio;
            if (sw > 0.0 && h > 1e-5) {
                float ex = Hx / h, ey = Hy / h;
                float pr = px * ex + py * ey;
                float pt = -px * ey + py * ex;
                float c  = max(1.0 - sw, 0.15);
                pr *= c;                          // squash the pupil; no light lost
                px = pr * ex - pt * ey;
                py = pr * ey + pt * ex;
            }
            if ((px - ox) * (px - ox) + (py - oy) * (py - oy) <= rr &&
                (px + ox) * (px + ox) + (py + oy) * (py + oy) <= rr)
                hit = 1;
        }
        if (hit == 0) { px = 0.0; py = 0.0; }   // centre of the opening: always clear

        // optical vignetting (the light the barrel rims block), from the lens as
        // designed; the Vignette slider scales it like natural vignetting
        if (apRatio > 0.0 && catEye0 > 0.0 && Vignette > 0.0) {
            float vx = catEye0 * od * Hx, vy = catEye0 * od * Hy;
            float vlen = sqrt(vx * vx + vy * vy);
            if (vlen > 1e-6) { float kv = omax * tanh(vlen / omax) / vlen; vx *= kv; vy *= kv; }
            // jittered per ray, so the estimate averages out smoothly (no banding)
            float inside = 0.0;
            float a0 = 2.0 * M_PI * rnd(r1, r2, 51.0);
            for (int k = 0; k < 16; k++) {
                float rk = sqrt((k + rnd(r2, r1, 60.0 + k)) / 16.0) * apRatio;
                float ak = a0 + 2.39996 * k;             // golden-angle spiral over the pupil
                float qx = rk * cos(ak) / S, qy = rk * sin(ak);
                if ((qx - vx) * (qx - vx) + (qy - vy) * (qy - vy) <= rr &&
                    (qx + vx) * (qx + vx) + (qy + vy) * (qy + vy) <= rr)
                    inside += 1.0;
            }
            weight *= pow(max(inside / 16.0, 0.25), 0.5 * Vignette);   // half the physical amount: a gentler start
        }

        // Seidel aberrations (sensor space)
        float pp  = px * px + py * py;
        float pH  = px * Hx + py * Hy;
        float saL = -sa * (1.0 + sphCA * t);
        float ax_ = saL * pp * px + coma * (2.0 * pH * px + pp * Hx) / 3.0 + astig * pH * Hx + fc * h2 * px;
        float ay_ = saL * pp * py + coma * (2.0 * pH * py + pp * Hy) / 3.0 + astig * pH * Hy + fc * h2 * py;
        float aScale = od * 0.01 * sensorW * 0.001;
        float dsx = ax_ * aScale;
        float dsy = ay_ * aScale;

        // diffraction (Airy core as a gaussian, sigma ~ 0.42 lambda N)
        float dsig = 0.42 * 550e-9 * (1.0 + 0.27 * t) * Nf;
        float dg   = sqrt(-2.0 * log(max(q[15], 1e-7)));
        sx += dsig * dg * cos(2.0 * M_PI * q[16]);
        sy += dsig * dg * sin(2.0 * M_PI * q[16]);

        // distortion + lateral CA
        float K1 = k1 * od, K2 = k2 * od;
        float dscale = 1.0 + K1 * h2 + K2 * h2 * h2;
        float e2 = (halfW / halfDiag) * (halfW / halfDiag);
        dscale /= (1.0 + K1 * e2 + K2 * e2 * e2);
        dscale *= 1.0 + latCA * od * 0.001 * t;
        float tx = S * sx * dscale / vEff;
        float ty = sy * dscale / vEff;

        // longitudinal CA: per-wavelength focus
        float dv = f * 0.001 * od * (longCA * t + secCA * (t * t - 0.333));
        float vl = max(vimg + dv, f * 1.0001);
        float Dl = f * vl / (vl - f);

        // focus plane (tilt-shift tilts it)
        vector d = vector(tx, ty, -1.0);
        vector n = vector(0.0, 0.0, 1.0);
        if (tilt != 0.0) {
            float a1 = radians(tilt);
            n = vector(0.0, -sin(a1), cos(a1));
        }
        float dn = dot(d, n);
        float tt = (fabs(dn) > 1e-6) ? dot(vector(0.0, 0.0, -Dl), n) / dn : Dl;
        if (tt <= 0.0) tt = Dl;
        float m  = tt / vimg;
        point F  = point(tt * d[0] + dsx * S * m, tt * d[1] + dsy * m, tt * d[2]);

        // aperture size: physical, times the style's boost; an F-stop below the lens's
        // widest keeps growing the aperture (the lens character stays wide open)
        float Rmax = f / (2.0 * maxF) * max(apBoost, 0.0) * max(maxF / max(FStop, 0.02), 1.0);
        Lp = point(px * Rmax, py * Rmax, 0.0);
        if (stereo != 0) {
            float e = EyeDistance * 0.005 * ((ch == 0) ? -1.0 : 1.0);
            Lp = point(Lp[0] + e, Lp[1], Lp[2]);
        }
        dcam = F - Lp;

        if (port != 0) {     // flat underwater port: air -> water
            vector rf = refract(normalize(dcam), vector(0.0, 0.0, 1.0), 1.0 / (1.333 - 0.006 * t));
            if (length(rf) > 0.0) dcam = rf;
        }
        float c2 = 1.0 / (1.0 + tx * tx + ty * ty);
        weight *= mix(1.0, c2 * c2, clamp(natVig * od, 0.0, 1.0)) * pow(c2, extraVig * sAmt);
        // Vignette above what the optics give: frame-relative, so it works on long lenses too
        weight *= max(1.0 - 0.45 * max(natVig * od - 1.0, 0.0) * pow(hField2, 1.25), 0.0);
    }
    else if (proj <= 3) {
        // ---------------- fisheyes ----------------
        float rref = (circle > 0.0) ? circle / aspect : 1.0;
        float r = sqrt(xn * xn + yn * yn) / rref;
        if (circle > 0.0 && r > 1.0) alive = 0;
        float th = 0.0;
        if (fov > 0.0) {                                     // fixed field of view (style presets)
            float Th = radians(fov) * 0.5;
            th = r * Th;                                     // equidistant
            if (proj == 2) th = 2.0 * atan(r * tan(Th * 0.5));    // stereographic
            if (proj == 3) {                                 // equisolid
                float s_ = r * sin(Th * 0.5);
                if (s_ > 1.0) alive = 0;
                th = 2.0 * asin(min(s_, 1.0));
            }
        } else {                                             // real fisheye: from focal length + sensor
            float uq = r * rref * (sensorW * 0.5) / max(FocalLength, 1.0);   // image radius / f
            th = uq;                                         // equidistant  r = f*theta
            if (proj == 2) th = 2.0 * atan(uq * 0.5);        // stereographic r = 2f*tan(theta/2)
            if (proj == 3) {                                 // equisolid    r = 2f*sin(theta/2)
                if (uq * 0.5 > 1.0) alive = 0;               // outside the image circle
                th = 2.0 * asin(min(uq * 0.5, 1.0));
            }
            if (th > 0.5 * M_PI) alive = 0;                  // a 180-degree fisheye's image circle
        }
        th *= 1.0 + latCA * od * 0.002 * t;
        if (th > M_PI) alive = 0;
        float ph = atan2(yn, xn);
        dcam = vector(sin(th) * cos(ph), sin(th) * sin(ph), -cos(th));
        float cth = max(cos(min(th * 0.5, 1.5)), 0.0);
        weight *= mix(1.0, pow(cth, 4.0), clamp(natVig * od, 0.0, 1.0)) * pow(cth, 2.0 * extraVig * sAmt);
        weight *= max(1.0 - 0.45 * max(natVig * od - 1.0, 0.0) * pow(hField2, 1.25), 0.0);
    }
    else if (proj == 4) {
        // ---------------- 360 equirectangular ----------------
        float lon = xn * M_PI;
        float lat = hy * 0.5 * M_PI;
        dcam = vector(sin(lon) * cos(lat), sin(lat), -cos(lon) * cos(lat));
    }
    else if (proj == 5) {
        // ---------------- tiny planet (stereographic around world down) ----
        vector dw = normalize(transform("world", "camera", vector(0.0, -1.0, 0.0)));
        vector xr = vector(1.0, 0.0, 0.0) - dot(vector(1.0, 0.0, 0.0), dw) * dw;
        if (length(xr) < 1e-4) xr = vector(0.0, 1.0, 0.0) - dot(vector(0.0, 1.0, 0.0), dw) * dw;
        xr = normalize(xr);
        vector yr = cross(dw, xr);
        float zm   = (zoom > 0.0) ? zoom : max(FocalLength, 1.0) / 12.0;   // own zoom, else focal
        float pr2  = sqrt(hx * hx + hy * hy) / zm;
        float th   = 2.0 * atan(pr2);
        float ph   = atan2(hy, hx);
        dcam = sin(th) * cos(ph) * xr - sin(th) * sin(ph) * yr + cos(th) * dw;
    }
    else if (proj == 6) {
        // ---------------- mirror ball ----------------
        float br = hx * hx + hy * hy;
        if (br > 1.0) alive = 0;
        vector nb = vector(hx, hy, sqrt(max(1.0 - br, 0.0)));
        vector vi = vector(0.0, 0.0, -1.0);
        dcam = vi - 2.0 * dot(vi, nb) * nb;
    }
    else if (proj == 7) {
        // ---------------- orthographic / isometric ----------------
        float f  = max(FocalLength, 1.0) * 0.001;
        float hw = (orthoWidth > 0.0) ? orthoWidth * 0.005                  // own width (cm), else focal
                                      : (FocusDistance * 0.01) * (sensorW * 0.0005) / f;
        Lp   = point(xn * hw, yn * hw, 0.0);
        dcam = vector(0.0, 0.0, -1.0);
    }
    else if (proj == 9) {
        // ---------------- reverse perspective (hypercentric) ----------------
        // Rays start spread over the camera plane and converge on a point
        // behind the subject, so farther things look bigger. The subject at
        // the focus distance keeps the framing a normal lens of this focal
        // length would give (or Ortho view width, if set).
        float f  = max(FocalLength, 1.0) * 0.001;
        float Df = max(FocusDistance * 0.01, 1e-3);
        float sR = max(revStrength, 0.0);
        float Cv = (sR > 1e-4) ? Df * (1.0 + 1.0 / sR) : 1e6;              // convergence point
        float wf = (orthoWidth > 0.0) ? orthoWidth * 0.005 : Df * (sensorW * 0.0005) / f;
        float hw = wf / max(1.0 - Df / Cv, 1e-3);                         // half-width at the camera
        Lp   = point(xn * hw, yn * hw, 0.0);
        dcam = point(0.0, 0.0, -Cv) - Lp;
    }
    else {
        // ---------------- Doom / Build engine: look up/down = y-shear ------
        vector wu = normalize(transform("world", "camera", vector(0.0, 1.0, 0.0)));
        float  sp = dot(vector(0.0, 0.0, -1.0), wu);
        vector fL = vector(0.0, 0.0, -1.0) - sp * wu;
        fL = (length(fL) < 1e-4) ? vector(0.0, 0.0, -1.0) : normalize(fL);
        vector rL = normalize(cross(fL, wu));
        float th_ = (fov > 0.0) ? tan(radians(fov) * 0.5) : (sensorW * 0.0005) / (max(FocalLength, 1.0) * 0.001);
        float pitchT = sp / max(sqrt(max(1.0 - sp * sp, 0.0)), 1e-3);
        dcam = fL + xn * th_ * rL + (yn * th_ + pitchT) * wu;
    }

    // ------------------------------------------- veiling haze / glow (all)
    if (haze > 0.0 && q[12] < haze * od) {
        vector dn_ = normalize(dcam);
        vector a   = (fabs(dn_[1]) < 0.9) ? vector(0.0, 1.0, 0.0) : vector(1.0, 0.0, 0.0);
        vector b1  = normalize(cross(dn_, a));
        vector b2  = cross(dn_, b1);
        float  gr  = sqrt(-2.0 * log(max(q[13], 1e-7)));
        dcam = dn_ + hazeSpread * gr * (cos(2.0 * M_PI * q[14]) * b1 + sin(2.0 * M_PI * q[14]) * b2);
    }

    // ----------------------------------------------------------------- emit
    if (alive != 0) {
        pos = transform("camera", "world", Lp);
        dir = transform("camera", "world", dcam);
        color castT = mix(color(1.0), castCol, clamp(castAmt * od * hField2, 0.0, 1.0));
        setmessage("octane:throughput", thr * weight * castT * sTint * tint);
    } else {
        pos  = P;
        dir  = vector(0.0);
        tMax = 0.0;
    }
}
